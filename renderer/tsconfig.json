{
  "extends": "../tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["components/*"],
      "@utils/*": ["utils/*"],
      "@services/*": ["services/*"],
      "@features/*": ["features/*"],
      "@layouts/*": ["layouts/*"],
      "@modules/*": ["modules/*"],
      "@config/*": ["config/*"],
      "@core/*": ["core/*"]
    }
  }
}